type hal_lineage_thermal_default, domain;
hal_server_domain(hal_lineage_thermal_default, hal_lineage_thermal)

type hal_lineage_thermal_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_thermal_default)

binder_call(hal_lineage_thermal_default, servicemanager)

r_dir_file(hal_lineage_thermal_default, sysfs_thermal)
allow hal_lineage_thermal_default sysfs_devices_system_cpu:file rw_file_perms;
